{
  "id": "volatility-hedge-v1",
  "name": "Volatility Hedge",
  "description": "Buy both Yes and No sides to profit from price movement in either direction",
  "version": "1.0.0",
  "enabled": false,
  "filters": {
    "categories": ["Sports", "Politics"],
    "exclude_categories": null,
    "min_price": "0.30",
