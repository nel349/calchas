{
  "id": "crypto-spread-compression-scalp",
  "name": "Crypto Spread Compression Scalper",
  "description": "Scalps 2-4% from spread compression as crypto markets approach settlement. Buys tight spreads (<2¢), sells when tighter. Conservative, high win rate.",
  "version": "1.0.0",
  "enabled": false,

  "filters": {
    "categories": null,
    "exclude_categories": null,
    "series_ticker": ["KXBTC15M", "KXETH15M", "KXBTC1H", "KXETH1H"],

    "min_price": "0.30",
    "max_price": "0.70",

    "min_volume": 8000,
    "min_open_interest": 2000,

    "min_time_to_event_minutes": 3,
    "max_time_to_event_minutes": 8,

    "min_momentum_pct": null,
    "momentum_lookback_minutes": null,

    "max_spread_cents": "0.02",
    "min_best_price_quantity": 150
  },

  "entry_rules": {
    "side": "CheaperSide",
    "position_size": 100,
    "position_size_unit": "Dollars",
    "order_type": "Limit",
    "limit_price_offset": "-0.005"
  },

  "exit_rules": {
    "take_profit_pct": "2.5",
    "stop_loss_pct": "1.0",
    "trailing_stop_pct": null,
    "trailing_stop_activation_pct": null,
    "max_hold_time_minutes": 3,
    "exit_order_type": "Limit"
  },

  "risk_limits": {
    "max_concurrent_positions": 5,
    "max_daily_loss_usd": "75.00",
    "max_position_loss_usd": "15.00",
    "loss_cooldown_minutes": 20
  }
}
