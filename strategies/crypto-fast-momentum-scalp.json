{
  "id": "crypto-fast-momentum-scalp",
  "name": "Crypto Fast Momentum Scalper",
  "description": "Scalps 2-5% gains from crypto markets in final 10 minutes. Catches rapid momentum swings, exits quickly. Requires 2%+ momentum in last 15 minutes.",
  "version": "1.0.0",
  "enabled": true,

  "filters": {
    "categories": null,
    "exclude_categories": null,
    "series_ticker": ["KXBTC15M", "KXETH15M"],

    "min_price": "0.20",
    "max_price": "0.80",

    "min_volume": 5000,
    "min_open_interest": 1000,

    "min_time_to_event_minutes": 5,
    "max_time_to_event_minutes": 10,

    "min_momentum_pct": "2.0",
    "momentum_lookback_minutes": 15,

    "max_spread_cents": "0.03",
    "min_best_price_quantity": 100
  },

  "entry_rules": {
    "side": "CheaperSide",
    "position_size": 50,
    "position_size_unit": "Dollars",
    "order_type": "Limit",
    "limit_price_offset": "-0.01"
  },

  "exit_rules": {
    "take_profit_pct": "3.0",
    "stop_loss_pct": "1.5",
    "trailing_stop_pct": null,
    "trailing_stop_activation_pct": null,
    "max_hold_time_minutes": 2,
    "exit_order_type": "Market"
  },

  "risk_limits": {
    "max_concurrent_positions": 3,
    "max_daily_loss_usd": "50.00",
    "max_position_loss_usd": "10.00",
    "loss_cooldown_minutes": 30
  }
}
