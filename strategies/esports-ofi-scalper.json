{
  "id": "esports-ofi-scalper",
  "name": "Esports OFI Scalper (All Games)",
  "description": "All esports (LoL, CS2, Dota2, Valorant, CoD, R6). Fast-paced like hockey. Aggressive test sizing.",
  "version": "1.0.0",
  "enabled": true,

  "filters": {
    "series_ticker": ["KXLOLGAME", "KXCSGOGAME", "KXCS2GAMES", "KXDOTA2GAME", "KXVALORANTGAME", "KXCODGAME", "KXR6GAME"],
    "min_price": "0.05",
    "max_price": "0.95",
    "min_volume": 10000,
    "min_momentum_pct": "1.0",
    "momentum_lookback_minutes": 5,
    "min_order_flow_imbalance": "0.50",
    "prioritize_live_games": true
  },

  "entry_rules": {
    "side": "ExpensiveSide",
    "position_size": 7,
    "position_size_unit": "Dollars",
    "order_type": "Limit",
    "limit_price_offset": "-0.005"
  },

  "exit_rules": {
    "take_profit_pct": "10.0",
    "stop_loss_pct": "5.0",
    "max_hold_time_minutes": 5,
    "settlement_aware_exit": true,
    "exit_order_type": "Market"
  },

  "risk_limits": {
    "max_concurrent_positions": 15,
    "max_daily_loss_usd": "50.00",
    "max_position_loss_usd": "10.00",
    "loss_cooldown_minutes": 15
  }
}
