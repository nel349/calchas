{
  "id": "high-volume-test",
  "name": "High Volume Test",
  "description": "Test strategy to watch price changes on highly active markets",
  "version": "1.0.0",
  "enabled": true,
  "filters": {
    "categories": null,
    "exclude_categories": null,
    "min_price": "0.01",
    "max_price": "0.99",
    "min_volume": 1000,
    "min_open_interest": 500,
    "min_time_to_event_minutes": 30,
    "max_time_to_event_minutes": 43200
  },
  "entry_rules": {
    "side": "CheaperSide",
    "position_size": 10,
    "position_size_unit": "Dollars",
    "order_type": "Market",
    "limit_price_offset": null
  },
  "exit_rules": {
    "take_profit_pct": "50.0",
    "stop_loss_pct": "30.0",
    "trailing_stop_pct": null,
    "trailing_stop_activation_pct": null,
    "max_hold_time_minutes": 1440,
    "exit_order_type": "Market"
  },
  "risk_limits": {
    "max_concurrent_positions": 5,
    "max_daily_loss_usd": "500.00",
    "max_position_loss_usd": "100.00",
    "loss_cooldown_minutes": 60
  }
}
