{
  "id": "crypto-near-settlement-rush-scalp",
  "name": "Crypto Near-Settlement Rush Scalper",
  "description": "Scalps 3-6% from final-minute volatility in crypto markets. Trades panic/FOMO in last 5 minutes. High risk, high reward. Requires strong momentum.",
  "version": "1.0.0",
  "enabled": false,

  "filters": {
    "categories": null,
    "exclude_categories": null,
    "series_ticker": ["KXBTC15M", "KXETH15M"],

    "min_price": "0.15",
    "max_price": "0.85",

    "min_volume": 10000,
    "min_open_interest": 3000,

    "min_time_to_event_minutes": 2,
    "max_time_to_event_minutes": 5,

    "min_momentum_pct": "3.0",
    "momentum_lookback_minutes": 10,

    "max_spread_cents": "0.05",
    "min_best_price_quantity": 200
  },

  "entry_rules": {
    "side": "CheaperSide",
    "position_size": 30,
    "position_size_unit": "Dollars",
    "order_type": "Market",
    "limit_price_offset": null
  },

  "exit_rules": {
    "take_profit_pct": "5.0",
    "stop_loss_pct": "2.0",
    "trailing_stop_pct": "1.0",
    "trailing_stop_activation_pct": "3.0",
    "max_hold_time_minutes": 1,
    "exit_order_type": "Market"
  },

  "risk_limits": {
    "max_concurrent_positions": 2,
    "max_daily_loss_usd": "40.00",
    "max_position_loss_usd": "10.00",
    "loss_cooldown_minutes": 60
  }
}
