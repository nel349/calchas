# Calchas Environment Variables
# Copy this file to .env and fill in your actual values
# .env is gitignored and will never be committed

# =============================================================================
# CONFIGURATION OVERRIDES
# =============================================================================
# Any config value can be overridden with environment variables
# Format: CALCHAS__SECTION__FIELD_NAME

# Example: Override strategy directory
# CALCHAS__RUNTIME__STRATEGY_DIR=/path/to/your/strategies

# =============================================================================
# KALSHI API CREDENTIALS (Phase 2)
# =============================================================================
# IMPORTANT: Keep these secret! Never commit actual credentials to git.
#
# Get demo credentials from: https://demo.kalshi.com/account/api-keys
# Get production credentials from: https://kalshi.com/account/api-keys

# Kalshi API Key ID (required for Phase 2+)
CALCHAS__KALSHI__API_KEY_ID=your-key-id-from-kalshi-dashboard

# Kalshi RSA Private Key (required for Phase 2+)
# Must be PEM-encoded with newlines escaped as \n
# Kalshi provides PKCS#1 format (-----BEGIN RSA PRIVATE KEY-----)
# Both PKCS#1 and PKCS#8 formats are supported
# Copy your private key from Kalshi dashboard and format it on one line
CALCHAS__KALSHI__PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"

# Use demo API (true) or production (false)
CALCHAS__KALSHI__USE_DEMO=true

# =============================================================================
# LOGGING
# =============================================================================
# Control log verbosity
# Options: trace, debug, info, warn, error
# RUST_LOG=info

# =============================================================================
# USAGE
# =============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual credentials
# 3. Run the app: cargo run
# 4. The app automatically loads .env at startup
