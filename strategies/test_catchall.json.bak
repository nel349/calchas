{
  "id": "test-catchall",
  "name": "Test Catch-All",
  "description": "Test strategy designed to catch real markets from Kalshi API",
  "version": "1.0.0",
  "enabled": true,
  "filters": {
    "categories": null,
    "exclude_categories": null,
    "min_price": "0.01",
    "max_price": "0.99",
    "min_volume": 10,
    "min_open_interest": null,
    "min_time_to_event_hours": 1,
    "max_time_to_event_hours": 1000000
  },
  "entry_rules": {
    "side": "CheaperSide",
    "position_size": 50,
    "order_type": "Limit",
    "limit_price_offset": "0.01"
  },
  "exit_rules": {
    "take_profit_pct": "100.0",
    "stop_loss_pct": "50.0",
    "trailing_stop_pct": null,
    "max_hold_time_hours": 48,
    "exit_order_type": "Market"
  },
  "risk_limits": {
    "max_concurrent_positions": 3,
    "max_daily_loss_usd": "50.00",
    "max_position_loss_usd": null,
    "loss_cooldown_minutes": null
  }
}
