    "position_size_unit": "Contracts",
    "order_type": "Market",
    "limit_price_offset": null
  },
  "exit_rules": {
    "take_profit_pct": "20.0",
    "stop_loss_pct": "15.0",
    "trailing_stop_pct": "5.0",
    "trailing_stop_activation_pct": "10.0",
    "max_hold_time_minutes": 360,
    "exit_order_type": "Market"
  },
  "risk_limits": {
    "max_concurrent_positions": 3,
    "max_daily_loss_usd": "200.00",
    "max_position_loss_usd": "100.00",
